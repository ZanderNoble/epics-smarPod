record(ao, "$(P)RB$(D)") {
    field(DESC, "New $(PIVOT_M)")
    field(DTYP, "Soft Channel")  # 使用软通道
    field(PREC, "5")
    field(EGU,"$(EGU)")
    field(FLNK, "$(P)$(D):RBLogic.PROC PP")  # 在 $(D) 处理完成后触发 $(D):Logic
}
record(calcout, "$(P)$(D):RBLogic") {
    field(INPA, "$(P)RB$(PIVOT_M) CP")  # 输入链接到 $(D)
    field(INPB, "$(P)$(D):NegOrPos CP")     # 输入链接到 NegOrPos
    field(CALC, "B==1?-A:A")       # 如果 NegOrPos 为 Neg (1)，则加负号
    field(OUT, "$(P)RB$(D) PP")       # 输出链接到 $(PIVOT_M)
    field(PREC, "5")
    field(SCAN, ".1 second")            # 设置为 Passive，通过 Forward Link 触发
}

