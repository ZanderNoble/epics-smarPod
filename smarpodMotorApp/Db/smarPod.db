record(ai, "$(P)CSYS_RX_RBV") {
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0,$(TIMEOUT))CSYS_RX")
    field(EGU,  "deg")
    field(PREC, "6")
    field(PINI, "YES")
    field(SCAN, "I/O Intr")
