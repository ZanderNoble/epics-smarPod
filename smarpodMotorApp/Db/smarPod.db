# CSYS_RY返回值
record(ai, "$(P)CSYS_RY_RBV") {
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0,$(TIMEOUT))CSYS_RY")
    field(EGU,  "deg")
    field(PREC, "6")
    field(PINI, "YES")
    field(SCAN, "I/O Intr")
