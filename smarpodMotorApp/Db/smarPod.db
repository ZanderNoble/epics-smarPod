# CSYS_RZ返回值
record(ai, "$(P)CSYS_RZ_RBV") {
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),0,$(TIMEOUT))CSYS_RZ")
    field(EGU,  "deg")
    field(PREC, "6")
    field(PINI, "YES")
    field(SCAN, "I/O Intr")
}
# 最大频率设置（可写）
record(ao, "$(P)MaxFrequency") {
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,$(TIMEOUT))MAX_FREQUENCY")
    field(VAL,  "3000")          # 默认值
    field(DRVL, "1")             # 最小值
    field(DRVH, "18500")         # 最大值
    field(PREC, "0")             # 整数
    field(EGU,  "Hz")            # 单位
    field(DESC, "最大闭环频率设置")
}

# 最大频率读取（只读）
record(ai, "$(P)MaxFrequency_RBV") {
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0,$(TIMEOUT))MAX_FREQUENCY")
    field(VAL,  "3000")
    field(PREC, "0")
    field(EGU,  "Hz")
    field(PINI, "YES")
    field(SCAN, "I/O Intr")
    field(DESC, "当前最大闭环频率")
}

