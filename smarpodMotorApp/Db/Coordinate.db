# 执行记录
record(bo, "$(P)$(R)CS_SET_EXEC") {
    field(DESC, "执行坐标系统设置")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(CS_SET_EXEC_INDEX)) PP")
    field(ZNAM, "Idle")
    field(ONAM, "Execute")
}

record(bo, "$(P)$(R)CS_ZERO_EXEC") {
    field(DESC, "当前姿态设为零")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(CS_ZERO_EXEC_INDEX)) PP")
    field(ZNAM, "Idle")
    field(ONAM, "Execute")
}

