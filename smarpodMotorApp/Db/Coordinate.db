record(ai, "$(P)$(R)CS_RZ_GET") {
    field(DESC, "坐标系统Rz读取 (°)")
    field(SCAN, "1 second")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(CS_RZ_GET_INDEX))")
