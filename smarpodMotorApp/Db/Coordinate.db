    field(DESC, "坐标系统Z读取 (m)")
    field(SCAN, "1 second")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(CS_Z_GET_INDEX))")
    field(PREC, "6")
    field(EGU,  "m")
