record(ai, "$(P)$(R)CS_RX_GET") {
    field(DESC, "坐标系统Rx读取 (°)")
    field(SCAN, "1 second")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(CS_RX_GET_INDEX))")
    field(PREC, "2")
    field(EGU,  "deg")
}

record(ai, "$(P)$(R)CS_RY_GET") {
    field(DESC, "坐标系统Ry读取 (°)")
    field(SCAN, "1 second")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(CS_RY_GET_INDEX))")
    field(PREC, "2")
