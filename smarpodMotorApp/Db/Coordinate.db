# 坐标系统设置PV
record(ao, "$(P)$(R)CS_X_SET") {
    field(DESC, "坐标系统X设置 (m)")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),$(CS_X_SET_INDEX))")
    field(VAL,  "0.0")
    field(PREC, "6")
    field(EGU,  "m")
}

record(ao, "$(P)$(R)CS_Y_SET") {
    field(DESC, "坐标系统Y设置 (m)")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),$(CS_Y_SET_INDEX))")
    field(VAL,  "0.0")
    field(PREC, "6")
    field(EGU,  "m")
}

record(ao, "$(P)$(R)CS_Z_SET") {
    field(DESC, "坐标系统Z设置 (m)")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),$(CS_Z_SET_INDEX))")
    field(VAL,  "0.015")
    field(PREC, "6")
    field(EGU,  "m")
}

record(ao, "$(P)$(R)CS_RX_SET") {
    field(DESC, "坐标系统Rx设置 (°)")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),$(CS_RX_SET_INDEX))")
    field(VAL,  "0.0")
    field(PREC, "2")
    field(EGU,  "deg")
    field(HOPR, "45")
    field(LOPR, "-45")
}

record(ao, "$(P)$(R)CS_RY_SET") {
    field(DESC, "坐标系统Ry设置 (°)")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),$(CS_RY_SET_INDEX))")
    field(VAL,  "0.0")
    field(PREC, "2")
    field(EGU,  "deg")
    field(HOPR, "45")
    field(LOPR, "-45")
}

record(ao, "$(P)$(R)CS_RZ_SET") {
    field(DESC, "坐标系统Rz设置 (°)")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),$(CS_RZ_SET_INDEX))")
    field(VAL,  "0.0")
    field(PREC, "2")
    field(EGU,  "deg")
    field(HOPR, "45")
    field(LOPR, "-45")
}

# 坐标系统获取PV
record(ai, "$(P)$(R)CS_X_GET") {
    field(DESC, "坐标系统X读取 (m)")
    field(SCAN, "1 second")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(CS_X_GET_INDEX))")
    field(PREC, "6")
    field(EGU,  "m")
}

record(ai, "$(P)$(R)CS_Y_GET") {
    field(DESC, "坐标系统Y读取 (m)")
    field(SCAN, "1 second")
    field(DTYP, "asynFloat64")
    field(INP,  "@asyn($(PORT),$(CS_Y_GET_INDEX))")
    field(PREC, "6")
    field(EGU,  "m")
}

